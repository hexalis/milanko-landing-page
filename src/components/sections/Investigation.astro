---
import type { CollectionEntry } from 'astro:content';
import { places, type Place } from '../../lib/earth-state';
interface Props { copy: CollectionEntry<'pages'>['data']['investigation'] }
const { copy } = Astro.props;
const regions = Object.keys(places) as Place[];
---
<section class="desk" id="case-desk" aria-label={copy.preview} data-copy={JSON.stringify(copy)} data-step="1">
  <div class="desk-bar"><span>{copy.sample}</span><span class="desk-meta" aria-hidden="true"><span class="desk-progress"><i></i><i></i><i></i></span><span data-counter>01 / 03</span></span></div>
  <form data-builder hidden>
    <fieldset>
      <legend>{copy.subject}</legend>
      <div class="themes">{copy.topic.map((name, i) => <label><input type="radio" name="topic" value={i} checked={i === 1} /><span>{name}</span></label>)}</div>
    </fieldset>
    <fieldset class="question-options">
      <legend>{copy.filter}</legend>
      {copy.questions.map((questions, topic) => <div data-question-set={topic} hidden={topic === 0}>
        {questions.map((question, direction) => <button class="question-choice" name="direction" type="submit" value={direction} style={`--i:${direction}`}>{question}<span aria-hidden="true">→</span></button>)}
      </div>)}
    </fieldset>
  </form>
  <div data-inspection hidden>
    <h3 tabindex="-1" data-case-question></h3>
    <div class="notebook">
      <p data-hint></p>
      <details class="table-help"><summary>{copy.readTable}</summary><p>{copy.instructions}</p></details>
      <p class="measure" data-measure></p>
      <div class="record-head" aria-hidden="true"><span>{copy.region}</span><span>{copy.reading}</span><span>{copy.baseline}</span></div>
      <ul class="record-list">
        {regions.map(key => <li>
          <button type="button" class="record" data-region={key} aria-pressed="false">
            <span class="record-name">{copy.regions[key]}<small>{copy.inspectRegion}</small></span>
            <span data-value></span><span data-range></span><i aria-hidden="true">›</i>
          </button>
        </li>)}
      </ul>
      <div class="record-detail" data-feedback hidden>
        <p data-notice role="status"></p>
        <button type="button" class="compare-action" data-compare hidden></button>
        <details class="hand-lens"><summary>{copy.lens}</summary><div class="ruler" aria-hidden="true"><i></i><b></b></div><p data-lens-note></p></details>
        <button type="button" class="button primary" data-close hidden>{copy.finish}<span aria-hidden="true">→</span></button>
      </div>
    </div>
    <button type="button" class="sub-action" data-reset>{copy.revise}</button>
  </div>
  <div data-complete hidden>
    <div class="seal"><span aria-hidden="true">✓</span>{copy.result}</div>
    <h3 tabindex="-1" data-verdict></h3>
    <p class="case-question" data-final-question></p>
    <p data-explanation></p>
    <details><summary>{copy.settings}</summary><dl>
      <div><dt>{copy.period}</dt><dd>{copy.periodValue}</dd></div>
      <div><dt>{copy.source}</dt><dd>{copy.sourceValue}</dd></div>
    </dl></details>
    <a class="text-link" href="#historia">{copy.next} ↓</a>
    <button type="button" class="sub-action" data-reset>{copy.again}</button>
  </div>
  <noscript><p>{copy.questions[1][0]} {copy.fallback}</p><details class="static-case"><summary>{copy.staticTitle}</summary><p>{copy.staticAnswer}</p><a class="text-link" href="#historia">{copy.next} ↓</a></details></noscript>
</section>
<script>
  import type { CollectionEntry } from 'astro:content';
  import { sampleRecords } from '../../lib/sample-records';
  import type { Place } from '../../lib/earth-state';
  const desk = document.querySelector<HTMLElement>('#case-desk')!;
  const copy: CollectionEntry<'pages'>['data']['investigation'] = JSON.parse(desk.dataset.copy!);
  const get = (selector: string) => desk.querySelector<HTMLElement>(selector)!;
  const builder = desk.querySelector('form')!;
  const buttons = [...desk.querySelectorAll<HTMLButtonElement>('[data-region]')];
  const atlas = document.querySelector<HTMLDetailsElement>('[data-atlas]')!;
  const invite = document.querySelector<HTMLElement>('[data-invitation]')!;
  const setStep = (step: 1 | 2 | 3) => { desk.dataset.step = String(step); get('[data-counter]').textContent = '0' + step + ' / 03'; };
  let selected: Place | undefined;
  let direction: 0 | 1 | 2 = 0;
  function query() {
    const fields = new FormData(builder);
    const index = fields.get('topic') === '0' ? 0 : 1;
    return { topic: index === 0 ? 'temperature' : 'rainfall', unit: index === 0 ? ' °C' : ' mm', index, direction, question: copy.questions[index][direction] } as const;
  }
  function showQuestions() {
    const {index} = query();
    for (const group of builder.querySelectorAll<HTMLElement>('[data-question-set]')) group.hidden = Number(group.dataset.questionSet) !== index;
  }
  function showBuilder() {
    selected = undefined;
    get('[data-inspection]').hidden = true;
    get('[data-complete]').hidden = true;
    builder.hidden = false;
    setStep(1);
    showQuestions();
    document.querySelector<HTMLButtonElement>('#reset-view:not([hidden])')?.click();
    atlas.open = false;
    atlas.hidden = true;
    invite.hidden = true;
    document.querySelector<HTMLElement>('[data-before-invitation]')!.hidden = false;
  }
  showBuilder();
  builder.addEventListener('change', showQuestions);
  builder.addEventListener('submit', e => {
    e.preventDefault();
    if (!(e.submitter instanceof HTMLButtonElement)) return;
    direction = Number(e.submitter.value) as 0 | 1 | 2;
    const {topic, index, unit, question} = query();
    get('[data-case-question]').textContent = question;
    get('[data-hint]').textContent = copy.hints[direction];
    desk.querySelector<HTMLDetailsElement>('.table-help')!.open = false;
    get('[data-final-question]').textContent = question;
    get('[data-measure]').textContent = copy.measure[index] + ' · 90 ' + (document.documentElement.lang === 'es' ? 'días' : 'days');
    for (const button of buttons) {
      const [low, high, value] = sampleRecords[button.dataset.region as Place][topic];
      button.querySelector('[data-value]')!.textContent = value + unit;
      button.querySelector('[data-range]')!.textContent = low + ' – ' + high + unit;
      button.setAttribute('aria-label', [copy.inspectRegion, copy.regions[button.dataset.region as Place], copy.reading, value + unit, copy.baseline, low + ' – ' + high + unit].join(', '));
      button.setAttribute('aria-pressed','false');
    }
    suggestion = undefined;
    get('[data-notice]').textContent = '';
    get('[data-close]').hidden = true;
    get('[data-feedback]').hidden = true;
    builder.hidden = true;
    get('[data-inspection]').hidden = false;
    setStep(2);
    get('[data-case-question]').focus();
  });
  function classify([low, high, value]: readonly [number, number, number]) {
    return value > high ? 0 : value < low ? 1 : 2;
  }
  let suggestion: HTMLButtonElement | undefined;
  get('[data-compare]').addEventListener('click', () => {
    suggestion?.focus();
    suggestion?.click();
  });
  for (const button of buttons) button.addEventListener('click', () => {
    const key = button.dataset.region as Place;
    const {topic, direction, unit} = query();
    const [low, high, value] = sampleRecords[key][topic];
    const position = classify(sampleRecords[key][topic]);
    selected = position === direction ? key : undefined;
    for (const item of buttons) item.setAttribute('aria-pressed', String(item === button));
    const limit = value < low ? low : high;
    const interpretation = [copy.above,copy.below,copy.between][position]!
      .replace('{gap}', Math.abs(value-limit) + unit).replace('{limit}', limit + unit)
      .replace('{value}', value + unit).replace('{range}', low + ' – ' + high + unit);
    const feedback = get('[data-feedback]');
    button.after(feedback);
    feedback.hidden = false;
    feedback.dataset.state = selected ? 'match' : 'retry';
    suggestion = selected ? undefined : buttons.find(candidate => classify(sampleRecords[candidate.dataset.region as Place][topic]) === direction);
    const compare = get('[data-compare]');
    compare.hidden = !suggestion;
    if (suggestion) compare.textContent = copy.compare.replace('{region}', copy.regions[suggestion.dataset.region as Place]) + ' →';
    get('[data-notice]').textContent = (selected ? copy.match : copy.miss).replace('{region}', copy.regions[key]).replace('{value}', value + unit).replace('{position}', copy.directions[position].toLowerCase());
    get('[data-lens-note]').textContent = interpretation;
    get('[data-explanation]').textContent = interpretation + ' ' + copy.cause;
    desk.querySelector<HTMLDetailsElement>('.hand-lens')!.open = false;
    const min = Math.min(low,value), max = Math.max(high,value);
    const mark = (n:number) => (8 + 84*(n-min)/(max-min)) + '%';
    const ruler = get('.ruler');
    ruler.style.setProperty('--low',mark(low));
    ruler.style.setProperty('--high',mark(high));
    ruler.style.setProperty('--reading',mark(value));
    get('[data-close]').hidden = !selected;
  });
  get('[data-close]').addEventListener('click', () => {
    if (!selected) return;
    atlas.hidden = false;
    invite.hidden = false;
    document.querySelector<HTMLElement>('[data-before-invitation]')!.hidden = true;
    const place = atlas.querySelector<HTMLButtonElement>(`[data-place="${selected}"]`)!;
    place.click();
    get('[data-verdict]').textContent = place.dataset.name!;
    get('[data-inspection]').hidden = true;
    get('[data-complete]').hidden = false;
    setStep(3);
    get('[data-verdict]').focus();
  });
  for (const button of desk.querySelectorAll('[data-reset]')) button.addEventListener('click', () => {
    desk.querySelector<HTMLDetailsElement>('[data-complete] details')!.open = false;
    showBuilder();
    builder.querySelector<HTMLInputElement>('input:checked')?.focus();
  });
</script>
<style>
  .desk { --pad:clamp(1.1rem,2.4vw,1.7rem); margin:1.8rem 0 2.5rem; padding:0 var(--pad); color:var(--ink); background:linear-gradient(145deg,#111d33f5 0%,#0a1222f7 62%,#0f1a2ef5 100%); border:1px solid #74a4ca4d; border-radius:14px; box-shadow:0 22px 55px #0207167a,inset 0 1px #cae7ff1a; overflow:hidden; }
  .desk-bar { display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-inline:calc(-1 * var(--pad)); padding:.85rem var(--pad); background:#0a1324a8; border-bottom:1px solid #74a4ca33; color:var(--atmosphere); font:.74rem/1.4 var(--font-mono); }
  .desk-bar > span:first-child { display:flex; align-items:center; gap:.6rem; }
  .desk-bar > span:first-child::before { content:''; width:.52rem; height:.52rem; background:var(--anomaly); border-radius:50%; }
  .desk-meta { display:flex; align-items:center; gap:.8rem; }
  .desk-progress { display:flex; gap:.3rem; }
  .desk-progress i { width:1.5rem; height:3px; border-radius:2px; background:#8bd5ff2e; transition:background 320ms var(--ease-out); }
  .desk[data-step="1"] .desk-progress i:first-child,.desk[data-step="2"] .desk-progress i:nth-child(-n+2),.desk[data-step="3"] .desk-progress i { background:var(--anomaly); }
  /* Each step, each set of questions and each reading eases in instead of swapping. */
  @keyframes desk-rise { from { opacity:0; transform:translateY(12px); } }
  form:not([hidden]),[data-inspection]:not([hidden]),[data-complete]:not([hidden]),.record-detail:not([hidden]) { animation:desk-rise 420ms var(--ease-out) both; }
  [data-question-set]:not([hidden]) .question-choice { animation:desk-rise 420ms var(--ease-out) both; animation-delay:calc(var(--i,0) * 60ms); }
  :global(html[data-motion=paused]) .desk :is(form,[data-inspection],[data-complete],.record-detail,.question-choice) { animation:none; }
  form,[data-inspection],[data-complete],noscript { display:block; padding:1.5rem 0; }
  [hidden] { display:none!important; }
  fieldset { border:0; margin:0; padding:0; min-width:0; }
  legend { padding:0; font-weight:600; margin-bottom:.65rem; }
  .themes { position:relative; display:inline-grid; grid-auto-flow:column; grid-auto-columns:1fr; padding:.25rem; border:1px solid #43536b; border-radius:2rem; background:#0a1120; }
  /* The pill slides under the chosen topic. */
  .themes::before { content:''; position:absolute; top:.25rem; bottom:.25rem; left:.25rem; width:calc(50% - .25rem); border-radius:2rem; background:var(--atmosphere); transition:transform 360ms var(--ease-out); }
  .themes:has(label:nth-child(2) :checked)::before { transform:translateX(100%); }
  .themes label { position:relative; min-height:44px; display:grid; place-items:center; padding:.55rem 1.4rem; border-radius:2rem; cursor:pointer; color:var(--muted); font-weight:500; transition:color 240ms var(--ease-out); }
  .themes label:hover { color:var(--ink); }
  .themes label:has(:checked) { color:var(--space-deep); }
  .themes input { position:absolute; inset:0; width:100%; height:100%; margin:0; opacity:0; cursor:pointer; }
  .themes label:focus-within { outline:2px solid var(--anomaly); outline-offset:2px; }
  .question-options { margin-top:1.5rem; }
  .question-choice { width:calc(100% + 1.3rem); margin-inline:-.65rem; display:flex; align-items:center; justify-content:space-between; gap:1rem; min-height:60px; padding:1rem .65rem; text-align:left; background:linear-gradient(90deg,#8bd5ff14,#8bd5ff00) no-repeat 0 0/0% 100%; border:0; border-top:1px solid #34445b; font:1.2rem/1.35 var(--font-serif); transition:background-size 360ms var(--ease-out),color 200ms; }
  .question-choice span { display:grid; place-items:center; width:2.1rem; height:2.1rem; flex:none; border:1px solid #536273; border-radius:50%; color:var(--anomaly); transition:transform 280ms var(--ease-out),background 200ms,color 200ms,border-color 200ms; }
  .question-choice:hover,.question-choice:focus-visible { color:var(--atmosphere); background-size:100% 100%; }
  .question-choice:hover span,.question-choice:focus-visible span { transform:translateX(4px); background:var(--anomaly); border-color:var(--anomaly); color:var(--space-deep); }
  .question-choice:active span { transform:translateX(7px) scale(.94); }
  .question-choice:focus-visible { outline-offset:-3px; }
  h3 { margin:0 0 .7rem; font:400 clamp(1.65rem,3vw,2.25rem)/1.12 var(--font-serif); }
  .case-question { font:1.2rem/1.42 var(--font-serif); margin:.35rem 0 1rem; }
  .notebook p,dd { line-height:1.5; }
  [data-hint],dt { color:var(--muted); }
  summary,.sub-action { min-height:44px; padding:.7rem 0; cursor:pointer; }
  .table-help summary,.hand-lens summary,.sub-action { color:var(--atmosphere); }
  .measure { margin:1.2rem 0 .7rem; font-weight:600; }
  .record-head,.record { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,.7fr) minmax(0,1fr) .8rem; align-items:center; gap:.4rem; padding:.55rem clamp(.55rem,1vw,.85rem); }
  .record-head { font-size:.75rem; color:var(--muted); }
  .record-list { list-style:none; margin:0; padding:0; display:grid; gap:.45rem; }
  .record { width:100%; min-height:59px; text-align:left; background:#142035; border:1px solid #40536d; border-radius:5px; color:var(--ink); cursor:pointer; transition:background 200ms,border-color 200ms,transform 140ms var(--ease-out); }
  .record:active { transform:scale(.99); }
  .record i { transition:transform 240ms var(--ease-out); }
  .record:hover i,.record[aria-pressed=true] i { transform:translateX(3px); }
  .record:hover,.record:focus-visible { background:#1d3048; border-color:var(--atmosphere); }
  .record[aria-pressed=true] { border-color:var(--anomaly); background:#222737; }
  .record-name { font-weight:600; line-height:1.3; }
  .record-name small { display:block; margin:.2rem 0 0; color:var(--atmosphere); font:400 .72rem/1.1 var(--font-sans); }
  .record i { font:1.5rem/1 var(--font-sans); color:var(--atmosphere); }
  .record [data-value],.record [data-range] { font-variant-numeric:tabular-nums; font-size:.92rem; }
  .record-detail { padding:1rem; margin-top:.2rem; background:#1a2639; border-radius:0 0 5px 5px; }
  .record-detail[data-state=match] { background:#122e3d; }
  [data-notice] { margin:0; }
  .compare-action { display:block; min-height:44px; margin-top:.7rem; padding:.55rem .9rem; border:1px solid var(--atmosphere); border-radius:4px; background:#21384a; color:#fff; text-align:left; font-weight:600; }
  .compare-action:hover { background:#30485b; }
  .ruler { position:relative; margin:.5rem 0 1rem; height:20px; border-bottom:1px solid #8197ab; background:repeating-linear-gradient(to right,#8197ab 0 1px,transparent 1px 5%) left bottom/100% 5px no-repeat; }
  .ruler i { position:absolute; left:var(--low); right:calc(100% - var(--high)); top:5px; height:8px; background:#7ba8b2; }
  .ruler b { position:absolute; left:var(--reading); top:0; width:3px; height:19px; background:var(--anomaly); }
  .ruler b::before { content:''; position:absolute; left:-3px; top:-2px; width:9px; height:9px; border-radius:50%; background:inherit; }
  [data-close] { margin-top:.5rem; }
  .seal { display:flex; align-items:center; gap:.55rem; margin-bottom:1rem; color:var(--atmosphere); font:.85rem var(--font-mono); }
  .seal span { display:grid; place-items:center; border:1px solid; border-radius:100%; width:24px; height:24px; }
  .sub-action { display:block; border:0; margin-top:.5rem; background:none; text-decoration:underline; text-underline-offset:4px; }
  dl { margin:.65rem 0; } dl div { margin-top:.7rem; } dd { margin:.15rem 0 0; }
  [data-explanation] { line-height:1.5; }
  @media(max-width:440px){ .record [data-value],.record [data-range]{font-size:.84rem} .record{row-gap:.2rem} }
</style>
