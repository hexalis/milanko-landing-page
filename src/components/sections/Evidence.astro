---
import { ui, type Locale } from '../../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = ui[locale];
const objects = copy.objects;
---
<section class="observatory" id="evidencia" aria-labelledby="evidence-title">
  <div class="wrap observatory-intro">
    <div><h2 id="evidence-title">{copy.observeTitle1}<br /><em>{copy.observeTitle2}</em></h2><p>{copy.observeIntro}</p></div>
    <p class="observatory-hint" id="lens-help" hidden>{copy.telescopeHint}</p><noscript><p>{copy.noScript}</p></noscript>
  </div>
  <div class="observatory-field" id="observatory-field" aria-label={copy.viewerLabel}>
    <div class="viewer-hud"><div class="observatory-tools"><button id="telescope-toggle" type="button" aria-controls="observatory-field" aria-describedby="lens-help" aria-pressed="false" data-on={copy.telescopeOn} data-off={copy.telescopeOff} hidden><svg class="telescope-icon" viewBox="0 0 32 32" aria-hidden="true"><circle cx="13" cy="13" r="8.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m19.5 19.5 8 8M8.5 12a4.5 4.5 0 0 1 4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span id="telescope-label">{copy.telescopeOn}</span></button></div><span><b id="discovery-count">00</b> / 04 <span class="hud-label">{locale === 'es' ? 'DESCUBIERTOS' : 'DISCOVERED'}</span></span></div>
    <svg class="sky-chart" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width=".7"><path d="M70 110 150 70 210 145 290 115M150 70 165 190M780 370 840 420 910 355 950 450M100 460 180 500 280 440 350 490"/><circle cx="500" cy="300" r="220" stroke-dasharray="2 14"/><path d="M500 60V540M100 300H900" stroke-dasharray="1 12"/></g><g fill="currentColor">{[[70,110],[150,70],[210,145],[290,115],[165,190],[780,370],[840,420],[910,355],[950,450],[100,460],[180,500],[280,440],[350,490]].map(([cx,cy]) => <circle cx={cx} cy={cy} r="2" />)}</g></svg>
    <div class="observatory-sky" aria-hidden="true"></div>
    <div class="observatory-stars" aria-hidden="true"></div>
    <div class="observatory-comet" aria-hidden="true"></div>
    <div class="observatory-reveal" aria-hidden="true"></div>
    <div class="observatory-nebula" aria-hidden="true"></div>
    <div class="observatory-beam" aria-hidden="true"></div>
    <div class="observatory-reticle" aria-hidden="true"><span></span><i></i></div>
    <span class="observatory-coordinate" aria-hidden="true">{copy.viewerCaption}</span>
    {objects.map(item => <button type="button" class={'discovery discovery-' + item.id} data-discovery={item.id} aria-pressed="false">
      <span class="discovery-glow" aria-hidden="true"></span><span class="discovery-orbit" aria-hidden="true"></span><span class="discovery-core" aria-hidden="true">
        {item.id === 'milanko' && <img class="milanko-symbol" src="/isotipo-milanko.svg" alt="" />}
        {item.id === 'senales' && <svg viewBox="0 0 80 80" aria-hidden="true"><path d="M4 47q16-34 36 0t36 0M4 60q16-34 36 0t36 0" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="40" cy="40" r="5" fill="currentColor"/></svg>}
        {item.id === 'datos' && <svg viewBox="0 0 80 80" aria-hidden="true"><path d="M12 24 25 11l13 13-13 13zm30 30 13-13 13 13-13 13zM31 31l18 18M40 24l16-16M24 54 8 70" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="40" cy="40" r="8" fill="currentColor"/></svg>}
      </span><span class="discovery-name">{item.name}</span>
    </button>)}
  </div>
  <div class="wrap observatory-detail" aria-live="polite">
    <button class="detail-close" type="button" aria-label={copy.closeDiscovery} hidden>×</button>
    <div><span id="discovery-label">{objects[0].label}</span><h3 id="discovery-title">{objects[0].name}</h3></div>
    <div><p id="discovery-description">{objects[0].description}</p><a id="discovery-link" href={objects[0].href}>{objects[0].action} <span aria-hidden="true">↗</span></a></div>
  </div>
  <noscript><div class="wrap module-list">{objects.map(module => <details><summary>{module.name}</summary><p>{module.description}</p><a href={module.href}>{module.action} <span aria-hidden="true">↗</span></a></details>)}</div></noscript>
  <p class="wrap observatory-note">{copy.viewerNote}</p>
</section>
<script define:vars={{ objects }}>
  const field = document.querySelector('#observatory-field');
  field.classList.add('is-ready');
  const telescope = document.querySelector('#telescope-toggle');
  telescope.hidden = false;
  document.querySelector('.observatory-hint').hidden = false;
  let active = false;
  const discoveries = new Set();
  telescope.addEventListener('click', () => {
    active = !active;
    field.classList.toggle('is-active', active);
    if (!active) {
      detail.hidden = true;
      for (const button of buttons) {
        button.classList.remove('is-found');
        button.setAttribute('aria-pressed','false');
      }
    }
    telescope.setAttribute('aria-pressed', String(active));
    document.querySelector('#telescope-label').textContent = active ? telescope.dataset.off : telescope.dataset.on;
    if (active) draw();
  });
  const stars = field.querySelector('.observatory-stars');
  let seed = 7129;
  const random = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
  const fragment = document.createDocumentFragment();
  for (let index = 0; index < 190; index++) {
    const star = document.createElement('i');
    star.style.left = (random() * 100).toFixed(2) + '%';
    star.style.top = (random() * 100).toFixed(2) + '%';
    star.style.setProperty('--size', (random() * 2.6 + 1).toFixed(1) + 'px');
    star.style.setProperty('--hue', String(190 + Math.floor(random() * 85)));
    if (index % 7 === 0) { star.classList.add('is-twinkling'); star.style.setProperty('--delay', (-random() * 8).toFixed(1) + 's'); }
    fragment.append(star);
  }
  stars.append(fragment);
  const buttons = [...field.querySelectorAll('[data-discovery]')];
  const detail = document.querySelector('.observatory-detail');
  detail.classList.add('is-enhanced');
  detail.hidden = true;
  const closeDetail = detail.querySelector('.detail-close');
  closeDetail.hidden = false;
  let lastSelected;
  closeDetail.addEventListener('click', () => { detail.hidden = true; lastSelected?.focus(); });
  new IntersectionObserver(([entry]) => detail.classList.toggle('is-visible', entry.intersectionRatio > .35), { threshold: .35 }).observe(field);
  const byId = Object.fromEntries(objects.map(item => [item.id, item]));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let width = field.clientWidth, height = field.clientHeight;
  let centers = buttons.map(button => [button.offsetLeft, button.offsetTop]);
  let x = width * .5, y = height * .45, targetX = x, targetY = y, frame = 0;
  new ResizeObserver(() => {
    const relativeX = targetX / Math.max(width, 1), relativeY = targetY / Math.max(height, 1);
    width = field.clientWidth; height = field.clientHeight;
    centers = buttons.map(button => [button.offsetLeft, button.offsetTop]);
    x = targetX = width * relativeX; y = targetY = height * relativeY;
    if (!frame) frame = requestAnimationFrame(draw);
  }).observe(field);
  const draw = () => {
    frame = 0;
    const factor = reduced.matches ? 1 : .22;
    x += (targetX - x) * factor; y += (targetY - y) * factor;
    field.style.setProperty('--light-x', (x / width * 100).toFixed(2) + '%');
    field.style.setProperty('--light-y', (y / height * 100).toFixed(2) + '%');
    const radius = width < 760 ? 105 : 160;
    buttons.forEach((button, index) => {
      const [centerX, centerY] = centers[index];
      const found = active && Math.hypot(centerX - x, centerY - y) < radius;
      button.classList.toggle('is-found', found);
      if (found) discoveries.add(button.dataset.discovery);
    });
    document.querySelector('#discovery-count').textContent = String(discoveries.size).padStart(2, '0');
    if (Math.abs(targetX - x) + Math.abs(targetY - y) > .5) frame = requestAnimationFrame(draw);
  };
  const point = (clientX, clientY) => {
    const rect = field.getBoundingClientRect();
    targetX = Math.max(0, Math.min(width, clientX - rect.left));
    targetY = Math.max(0, Math.min(height, clientY - rect.top));
    if (!frame) frame = requestAnimationFrame(draw);
  };
  field.addEventListener('pointermove', event => { if (active && !event.target.closest('.viewer-hud')) point(event.clientX, event.clientY); }, { passive: true });
  field.addEventListener('touchmove', event => { if (active && !event.target.closest('.viewer-hud') && event.touches[0]) point(event.touches[0].clientX, event.touches[0].clientY); }, { passive: true });
  buttons.forEach(button => button.addEventListener('focus', () => {
    const rect = button.getBoundingClientRect();
    if (active) point(rect.left + rect.width / 2, rect.top + rect.height / 2);
  }));
  buttons.forEach(button => button.addEventListener('click', () => {
    const item = byId[button.dataset.discovery];
    lastSelected = button;
    detail.hidden = false;
    active = true;
    field.classList.add('is-active');
    telescope.setAttribute('aria-pressed', 'true');
    document.querySelector('#telescope-label').textContent = telescope.dataset.off;
    buttons.forEach(other => other.setAttribute('aria-pressed', String(other === button)));
    document.querySelector('#discovery-label').textContent = item.label;
    document.querySelector('#discovery-title').textContent = item.name;
    document.querySelector('#discovery-description').textContent = item.description;
    const link = document.querySelector('#discovery-link');
    link.href = item.href;
    link.textContent = item.action + ' ↗';
    const rect = button.getBoundingClientRect();
    point(rect.left + rect.width / 2, rect.top + rect.height / 2);
  }));
</script>
<style>
  .module-list summary { padding:.7rem 0; cursor:pointer; }
  .module-list p { margin-bottom:1rem; }

  .observatory{overflow:hidden;background:linear-gradient(180deg,#060b19 0%,#060b19 70%,#0e1830 100%);color:white;padding:104px 0 72px;border-top:1px solid #273551}
  .observatory-intro{display:flex;align-items:end;justify-content:space-between;gap:40px;margin-bottom:40px}
  .observatory h2{font-size:clamp(42px,5.2vw,76px);line-height:1.07;letter-spacing:-.035em}
  .observatory h2 em{font:400 .92em/1.1 var(--font-serif);color:var(--atmosphere)}
  .observatory-intro p{color:#d3dced}.observatory-intro>div p{font-size:18px;max-width:530px;margin-top:22px}.observatory-hint{max-width:230px;font-size:13px}
  .observatory-field{--light-x:50%;--light-y:45%;position:relative;height:clamp(470px,55vw,680px);overflow:hidden;touch-action:pan-y;background:#060b19;border-block:1px solid #28436a}
  .observatory-sky{position:absolute;inset:0;background:url('/textures/milky-way.jpg') center/cover;filter:saturate(.65) brightness(.45)}
  .observatory-field::before{content:'';position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,#060b19b0,transparent 30%,transparent 70%,#060b19b0),linear-gradient(0deg,#060b19ce,transparent 25%,transparent 80%,#060b19a8);pointer-events:none}
  .observatory-beam{position:absolute;z-index:2;inset:0;pointer-events:none;background:radial-gradient(circle at var(--light-x) var(--light-y),#b2d9ff38,transparent 32%)}
  .observatory-reticle{position:absolute;z-index:3;left:var(--light-x);top:var(--light-y);width:165px;aspect-ratio:1;transform:translate(-50%,-50%);border:1px solid #c5e8ff84;border-radius:50%;box-shadow:0 0 0 22px #8bd5ff0b,0 0 55px #8bd5ff30;pointer-events:none;transition:left .12s ease-out,top .12s ease-out}
  .observatory-reticle::after{content:'';position:absolute;inset:40%;border:1px solid #d2efffaa;border-radius:50%}
  .observatory-coordinate{position:absolute;z-index:3;left:4%;bottom:20px;font:11px var(--font-mono);letter-spacing:.1em;color:#d3e8ff}
  .discovery{position:absolute;z-index:4;width:130px;height:130px;transform:translate(-50%,-50%);background:none;border:0;color:white;display:grid;place-items:center;cursor:pointer}
  .discovery-tierra{left:25%;top:38%}.discovery-senales{left:73%;top:24%}.discovery-datos{left:68%;top:70%}.discovery-milanko{left:33%;top:78%}
  .discovery-orbit{position:absolute;width:87px;height:87px;border:1px solid #b9e1ffab;border-radius:50%;box-shadow:0 0 25px #83caff4d,inset 0 0 22px #8bd5ff2b;transition:transform .35s var(--ease-out)}
  .discovery-core{width:16px;height:16px;border-radius:50%;background:#c9eaff;box-shadow:0 0 20px 8px #8bd5ff87}
  .discovery-tierra .discovery-core{width:68px;height:68px;background:url('/textures/earth-day.jpg') 49% 50%/230% 115%;box-shadow:inset -15px -7px 15px #061429,0 0 18px #8bd5ffbb;border:1px solid #a9d9f4}
  .discovery-senales .discovery-orbit{border-style:dashed}.discovery-senales .discovery-core,.discovery-datos .discovery-core,.discovery-milanko .discovery-core{width:72px;height:72px;background:#0e1b32;display:grid;place-items:center}
  .discovery-senales svg,.discovery-datos svg{width:52px;height:52px;color:#90d6f9}.discovery-datos svg{color:#ffab76}.discovery-milanko .discovery-core{border:1px solid #ffb789;box-shadow:0 0 25px #ff8a4c66}.milanko-symbol{width:46px;height:46px;object-fit:contain}
  .discovery-name{position:absolute;top:104px;white-space:nowrap;font-size:13px;font-weight:500;text-shadow:0 2px 8px #000}
  .discovery:hover .discovery-orbit,.discovery[aria-pressed=true] .discovery-orbit{transform:scale(1.15);border-color:white}.discovery:focus-visible{outline:2px solid var(--anomaly);border-radius:50%}
  .observatory-detail{display:grid;grid-template-columns:1fr 1.4fr;align-items:center;gap:42px;padding-block:36px;min-height:165px;border-bottom:1px solid var(--space-border)}
  .observatory-detail.is-enhanced{position:fixed;z-index:30;bottom:18px;left:50%;transform:translate(-50%,14px);max-width:1000px;padding:22px 58px 22px 28px;background:#101c31f5;border:1px solid #729abd;border-radius:12px;box-shadow:0 14px 45px #0009;backdrop-filter:blur(12px);min-height:135px;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .25s ease-out,transform .25s ease-out,visibility .25s}
  .observatory-detail.is-enhanced.is-visible{opacity:1;visibility:visible;pointer-events:auto;transform:translate(-50%,0)}
  .detail-close{position:absolute;right:14px;top:12px;width:38px;height:38px;border:0;background:transparent;color:#c4def2;font-size:28px;line-height:1}
  .detail-close:hover{color:white}
  .observatory-detail span:first-child{font:12px var(--font-mono);color:var(--atmosphere)}.observatory-detail h3{font-size:31px;margin-top:8px}.observatory-detail p{max-width:590px;color:#d3dced}
  .observatory-detail a{color:var(--anomaly);font-weight:500;white-space:nowrap;text-decoration:underline;text-underline-offset:5px}.observatory-detail #discovery-pending{color:var(--muted);font:13px var(--font-mono)}
  .observatory-note{padding-top:18px;color:#b4bdd2;font-size:12px}
  .observatory-comet{position:absolute;z-index:3;top:15%;left:-20%;width:120px;height:1px;transform:rotate(-20deg);background:linear-gradient(90deg,transparent,#ccefff);box-shadow:0 0 14px #8bd5ff;opacity:0;pointer-events:none;animation:comet-pass 18s linear infinite}
  @keyframes comet-pass{8%{opacity:0;left:-20%}10%{opacity:.7}20%{opacity:0;left:120%}100%{opacity:0;left:120%}}
  .observatory-field.is-ready .discovery-orbit,.observatory-field.is-ready .discovery-core{opacity:.08}.observatory-field.is-ready .discovery-name{opacity:0}.observatory-field .discovery.is-found .discovery-orbit,.observatory-field .discovery.is-found .discovery-core,.observatory-field .discovery.is-found .discovery-name,.observatory-field .discovery:focus-visible .discovery-orbit,.observatory-field .discovery:focus-visible .discovery-core,.observatory-field .discovery:focus-visible .discovery-name{opacity:1}
  .discovery:focus-visible{outline-offset:-10px}
  .observatory-field.is-active .observatory-comet{opacity:1}
  :global(html[data-motion=paused]) .observatory-comet,:global(html[data-motion=paused]) .observatory-stars :global(i.is-twinkling){animation:none}
  .observatory-tools{max-width:270px}.observatory-tools button{display:flex;align-items:center;gap:12px;min-height:50px;min-width:210px;margin-bottom:12px;padding:8px 15px;background:#15243c;border:1px solid #7195b7;color:white;border-radius:5px;font-weight:500}.observatory-tools button:hover,.observatory-tools button[aria-pressed=true]{background:#264a70;border-color:#b4e4ff}.telescope-icon{width:32px;height:32px;flex:none;color:var(--atmosphere)}
  .observatory-sky{opacity:.25;transition:opacity .7s}.observatory-field.is-active .observatory-sky{opacity:.44}
  .observatory-stars{position:absolute;inset:0;z-index:2;pointer-events:none}.observatory-stars :global(i){position:absolute;display:block;width:var(--size);height:var(--size);border-radius:50%;background:hsl(var(--hue) 85% 82%);box-shadow:0 0 8px 2px hsl(var(--hue) 90% 70% / .6);opacity:.35}.observatory-stars :global(i.is-twinkling){animation:star-breathe 6s ease-in-out var(--delay) infinite}@keyframes star-breathe{50%{opacity:.95;transform:scale(1.8)}}
  .observatory-reveal{position:absolute;inset:0;z-index:2;pointer-events:none;background:url('/textures/milky-way.jpg') center/cover;filter:saturate(1.7) brightness(1.25);opacity:0;mask-image:radial-gradient(circle 200px at var(--light-x) var(--light-y),#000 0%,transparent 100%);transition:opacity .5s}.observatory-field.is-active .observatory-reveal{opacity:1}
  .observatory-nebula{position:absolute;inset:0;z-index:2;pointer-events:none;background:radial-gradient(ellipse 330px 200px at 28% 40%,#2897c290,transparent 76%),radial-gradient(ellipse 280px 210px at 74% 28%,#7153c083,transparent 77%),radial-gradient(ellipse 350px 230px at 67% 69%,#d96c3799,transparent 75%),radial-gradient(ellipse 250px 220px at 33% 78%,#a66ba281,transparent 75%);opacity:0;mask-image:radial-gradient(circle 240px at var(--light-x) var(--light-y),#000 10%,transparent 100%);transition:opacity .5s}.observatory-field.is-active .observatory-nebula{opacity:1}
  .observatory-beam{opacity:0;transition:opacity .5s}.observatory-field.is-active .observatory-beam{opacity:1}
  .observatory-reticle{opacity:0;transition:opacity .4s}.observatory-field.is-active .observatory-reticle{opacity:1}
  .discovery-glow{position:absolute;inset:10px;border-radius:50%;filter:blur(18px);background:radial-gradient(circle,#69c4ffaa,transparent 70%);opacity:0;transition:opacity .4s}.discovery-datos .discovery-glow,.discovery-milanko .discovery-glow{background:radial-gradient(circle,#ff914fbb,transparent 70%)}.observatory-field.is-active .discovery:hover .discovery-glow,.observatory-field.is-active .discovery[aria-pressed=true] .discovery-glow{opacity:1}
  .discovery-orbit,.discovery-core,.discovery-name{transition:opacity .4s,transform .35s var(--ease-out)}
  @media(max-width:760px){.observatory{padding-top:72px}.observatory-intro{display:block;margin-bottom:26px}.observatory-intro>div p{font-size:16px}.observatory-tools{max-width:none;margin-top:20px}.observatory-hint{max-width:none}.observatory-field{height:540px}.discovery{width:100px;height:100px}.discovery-orbit{width:75px;height:75px}.discovery-name{top:80px;font-size:12px}.discovery-tierra{left:27%;top:27%}.discovery-senales{left:72%;top:20%}.discovery-datos{left:70%;top:67%}.discovery-milanko{left:27%;top:76%}.observatory-reticle{width:120px}.observatory-detail{grid-template-columns:1fr;gap:14px;padding-block:28px}.observatory-detail h3{font-size:27px}.observatory-coordinate{font-size:9px;bottom:10px}}
  @media(max-width:760px){.observatory-detail.is-enhanced{width:calc(100% - 24px);bottom:12px;display:block;max-height:42svh;overflow:auto;padding:18px 45px 20px 20px;min-height:0}.observatory-detail.is-enhanced h3{margin-top:3px}.observatory-detail.is-enhanced p{font-size:13px;line-height:1.45;margin-top:10px}.observatory-detail.is-enhanced a,.observatory-detail.is-enhanced #discovery-pending{display:inline-block;margin-top:12px;font-size:13px}}
  @media(prefers-reduced-motion:reduce){.observatory-detail.is-enhanced{transition:none}}
  @media(prefers-reduced-motion:reduce){.observatory-reticle,.discovery-orbit{transition:none}.observatory-comet,.observatory-stars :global(i.is-twinkling){animation:none}}
  .viewer-hud { align-items:center; }
  .viewer-hud .observatory-tools { margin:0; pointer-events:auto; }
  .viewer-hud .observatory-tools button { margin:0; min-width:0; min-height:46px; padding:.5rem .95rem; gap:.6rem; background:var(--anomaly); border:1px solid var(--anomaly); border-radius:24px; color:#0b1120; box-shadow:0 4px 16px #02081766; font:600 .95rem/1.2 var(--font-sans); }
  .viewer-hud .telescope-icon { width:24px; height:24px; color:inherit; }
  .viewer-hud .observatory-tools button:hover { background:#ffc096; }
  .viewer-hud .observatory-tools button[aria-pressed=true] { background:#172a40; color:#fff; border-color:var(--atmosphere); }
</style>
<style>
  .observatory-field{width:calc(100% - 80px);max-width:1440px;margin-inline:auto;border:1px solid #58799c66;border-radius:16px;box-shadow:0 30px 100px #0005,inset 0 0 100px #0006}
  .viewer-hud{position:absolute;z-index:5;inset:0 0 auto;display:flex;justify-content:space-between;gap:20px;padding:22px 28px;font:10px var(--font-mono);letter-spacing:.12em;color:#b7cfe7;background:linear-gradient(#081020ee,#08102000);pointer-events:none}
  .viewer-hud i{display:inline-block;width:5px;height:5px;background:#ff8a4c;border-radius:50%;margin-right:8px;box-shadow:0 0 12px #ff8a4c}
  .viewer-hud b{color:white;font-weight:400;font-size:15px}
  .sky-chart{position:absolute;inset:0;width:100%;height:100%;color:#88b9db;opacity:.25;z-index:2;pointer-events:none}
  .observatory-sky{opacity:.48;filter:saturate(.85) brightness(.6)}
  .observatory-field.is-active .observatory-sky{opacity:.6}
  .observatory-reveal{filter:saturate(1.6) brightness(1.7)}
  .observatory-reticle{width:210px;border:1px solid #d3ecff88;box-shadow:0 0 0 8px #08122099,0 0 0 9px #8bd5ff33,inset 0 0 35px #8bd5ff20,0 0 60px #8bd5ff22;transition:opacity .4s}
  .observatory-reticle::before{content:'';position:absolute;inset:-17px;border-radius:50%;background:repeating-conic-gradient(from 0deg,#8bd5ff80 0deg 1deg,transparent 1deg 15deg);mask:radial-gradient(transparent 67%,#000 68% 70%,transparent 71%)}
  .observatory-reticle::after{inset:auto;left:84%;top:86%;width:31%;height:10px;border:1px solid #8eb7c8;border-radius:5px;background:#254052;transform:rotate(45deg);transform-origin:left center}
